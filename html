<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Flexbox Quest</title>

    <style>
        /* =====================================================
           BASIC STYLES
        ===================================================== */

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #101728;
            color: #ffffff;
        }

        h1 {
            margin: 0;
            color: #ffe066;
            font-size: 32px;
        }

        h2 {
            margin-top: 0;
            color: #7dd3fc;
        }

        h3 {
            color: #ffe066;
        }

        button {
            font-family: Arial, sans-serif;
            cursor: pointer;
        }


        /* =====================================================
           PART 2 — DISPLAY PROPERTY EXPERIMENT
        ===================================================== */

        .display-experiment {
            background-color: #172033;
            padding: 20px;
            margin: 20px auto;
            width: 90%;
            border: 2px solid #2d3b59;
            border-radius: 12px;
        }

        .display-experiment h2 {
            margin-bottom: 15px;
        }

        /*
            These examples demonstrate the required
            display properties.
        */

        .box {
            display: inline-block;
            background-color: #2563eb;
            color: white;
            width: 100px;
            padding: 15px;
            margin: 5px;
            text-align: center;
            border-radius: 8px;
        }

        .item {
            display: inline;
            color: #facc15;
            margin: 5px;
        }

        .display-link {
            display: inline-block;
            background-color: #374151;
            color: white;
            padding: 8px 12px;
            margin: 5px;
            border-radius: 6px;
            text-decoration: none;
        }

        .flex-demo {
            display: flex;
            gap: 10px;
            background-color: #0f172a;
            padding: 15px;
            margin-top: 15px;
            border-radius: 8px;
        }

        .flex-demo div {
            background-color: #16a34a;
            padding: 12px;
            border-radius: 6px;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;

            background-color: #1e293b;
            padding: 18px 25px;
            margin: 0;
            border-bottom: 3px solid #7dd3fc;
        }

        .game-info {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            justify-content: center;
        }

        .game-info span {
            background-color: #334155;
            padding: 8px 12px;
            border: 1px solid #475569;
            border-radius: 8px;
            font-size: 14px;
        }

        .header-actions {
            display: flex;
            gap: 10px;
        }

        .header-actions button {
            background-color: #475569;
            color: white;
            border: 1px solid #64748b;
            padding: 9px 14px;
            border-radius: 7px;
        }

        .header-actions button:hover {
            background-color: #64748b;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        main {
            width: 90%;
            max-width: 1200px;
            margin: 25px auto;
        }


        /* =====================================================
           GAME AREA
        ===================================================== */

        .game-area {
            min-height: 500px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;

            background-color: #3b82b6;
            padding: 30px;
            border: 4px solid #7dd3fc;
            border-radius: 15px;

            overflow: hidden;
        }

        .game-area-title {
            background-color: #1e3a5f;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            border: 1px solid #93c5fd;
        }

        .player {
            background-color: #ef4444;
            color: white;
            padding: 18px 25px;
            border: 3px solid #991b1b;
            border-radius: 12px;
            font-weight: bold;
        }

        .star {
            background-color: #facc15;
            color: #713f12;
            padding: 15px 20px;
            border: 3px solid #a16207;
            border-radius: 50%;
            font-weight: bold;
        }

        .platform-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px;
            width: 100%;
        }

        .platform {
            background-color: #713f12;
            color: white;
            padding: 15px 35px;
            border: 3px solid #422006;
            border-radius: 8px;
            font-weight: bold;
        }

        .game-message {
            background-color: #172554;
            color: #dbeafe;
            padding: 12px 20px;
            border: 2px solid #60a5fa;
            border-radius: 10px;
            text-align: center;
        }


        /* =====================================================
           GAME PANELS
        ===================================================== */

        .game-panels {
            display: flex;
            gap: 20px;
            margin-top: 25px;
        }

        .panel {
            flex: 1;

            background-color: #1e293b;
            padding: 20px;
            border: 2px solid #334155;
            border-radius: 12px;

            min-width: 0;
        }

        .panel h2 {
            border-bottom: 2px solid #475569;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }


        /* =====================================================
           CONTROLS
        ===================================================== */

        .control-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .control-row button,
        .jump-button {
            background-color: #475569;
            color: white;
            border: 2px solid #64748b;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
            padding: 12px 18px;
        }

        .control-row button:hover,
        .jump-button:hover {
            background-color: #64748b;
        }

        .jump-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 10px;
        }

        .jump-button {
            background-color: #2563eb;
            border-color: #60a5fa;
            padding: 12px 30px;
        }


        /* =====================================================
           INVENTORY
        ===================================================== */

        .inventory-items {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .inventory-item {
            padding: 15px;
            border: 2px solid #64748b;
            border-radius: 8px;
            background-color: #334155;
            color: #ffffff;
            text-align: center;
            flex: 1;
        }


        /* =====================================================
           QUEST PANEL
        ===================================================== */

        .quest-item {
            display: flex;
            justify-content: space-between;
            align-items: center;

            background-color: #334155;
            padding: 12px;
            margin-bottom: 10px;
            border: 1px solid #475569;
            border-radius: 8px;
            gap: 10px;
        }

        .quest-progress {
            background-color: #16a34a;
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 13px;
            white-space: nowrap;
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        footer {
            background-color: #0f172a;
            color: #94a3b8;
            text-align: center;
            padding: 25px;
            margin-top: 30px;
            border-top: 2px solid #334155;
        }


        /* =====================================================
           RESPONSIVE DESIGN
        ===================================================== */

        @media (max-width: 768px) {

            .game-header {
                flex-direction: column;
                text-align: center;
            }

            .game-info {
                flex-wrap: wrap;
            }

            .header-actions {
                justify-content: center;
            }

            .game-area {
                min-height: 450px;
                padding: 20px;
            }

            .platform-row {
                gap: 10px;
                flex-wrap: wrap;
            }

            .platform {
                padding: 12px 20px;
            }

            .game-panels {
                flex-direction: column;
            }

            .panel {
                width: auto;
            }
        }


        /* =====================================================
           SMALL MOBILE DEVICES
        ===================================================== */

        @media (max-width: 375px) {

            main {
                width: 94%;
            }

            .game-header {
                padding: 15px;
            }

            h1 {
                font-size: 26px;
            }

            .game-info span {
                font-size: 12px;
                padding: 7px 9px;
            }

            .game-area {
                min-height: 400px;
                padding: 15px;
            }

            .player {
                padding: 14px 18px;
            }

            .star {
                padding: 12px 15px;
            }

            .platform {
                padding: 10px 15px;
                font-size: 14px;
            }

            .panel {
                padding: 15px;
            }

            .inventory-item {
                min-width: 70px;
                padding: 12px 8px;
                font-size: 13px;
            }
        }
    </style>
</head>

<body>


    <!-- =====================================================
         PART 2 — DISPLAY EXPERIMENT
    ====================================================== -->

    <section class="display-experiment">

        <h2>Display Property Experiment</h2>

        <div class="box">Box 1</div>
        <div class="box">Box 2</div>

        <p>
            <span class="item">Item 1</span>
            <span class="item">Item 2</span>
        </p>

        <a href="#" class="display-link">Link 1</a>
        <a href="#" class="display-link">Link 2</a>

        <div class="flex-demo">
            <div>Flex Item 1</div>
            <div>Flex Item 2</div>
            <div>Flex Item 3</div>
        </div>

    </section>


    <!-- =====================================================
         PART 3 — GAME HEADER
    ====================================================== -->

    <header class="game-header">

        <h1>Flexbox Quest</h1>

        <div class="game-info">
            <span>Lives: 3</span>
            <span>Coins: 120</span>
            <span>Level: 1</span>
            <span>Score: 1250</span>
        </div>

        <div class="header-actions">
            <button type="button">Pause</button>
            <button type="button">Menu</button>
        </div>

    </header>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main>


        <!-- =================================================
             PART 4 — GAME AREA
        ================================================== -->

        <section class="game-area">

            <div class="game-area-title">
                GAME AREA
            </div>

            <div class="player">
                PLAYER
            </div>

            <div class="star">
                ★ STAR
            </div>

            <div class="game-message">
                Collect all the stars!
            </div>

            <div class="platform-row">

                <div class="platform">
                    PLATFORM
                </div>

                <div class="platform">
                    PLATFORM
                </div>

                <div class="platform">
                    PLATFORM
                </div>

            </div>

        </section>


        <!-- =================================================
             PART 5 — GAME PANELS
        ================================================== -->

        <section class="game-panels">


            <!-- =============================================
                 CONTROLS
            ============================================== -->

            <div class="panel controls">

                <h2>Controls</h2>

                <div class="control-row">
                    <button type="button">↑</button>
                </div>

                <div class="control-row">
                    <button type="button">←</button>
                    <button type="button">↓</button>
                    <button type="button">→</button>
                </div>

                <div class="jump-container">
                    <button class="jump-button" type="button">
                        JUMP
                    </button>
                </div>

            </div>


            <!-- =============================================
                 INVENTORY
            ============================================== -->

            <div class="panel inventory">

                <h2>Inventory</h2>

                <div class="inventory-items">

                    <div class="inventory-item">
                        Sword
                    </div>

                    <div class="inventory-item">
                        Shield
                    </div>

                    <div class="inventory-item">
                        Potion
                    </div>

                    <div class="inventory-item">
                        Key
                    </div>

                    <div class="inventory-item">
                        Bow
                    </div>

                    <div class="inventory-item">
                        Map
                    </div>

                </div>

            </div>


            <!-- =============================================
                 QUEST
            ============================================== -->

            <div class="panel quest">

                <h2>Quest</h2>

                <div class="quest-item">

                    <span>
                        Collect 3 Stars
                    </span>

                    <span class="quest-progress">
                        1 / 3
                    </span>

                </div>

                <div class="quest-item">

                    <span>
                        Find the Golden Key
                    </span>

                    <span class="quest-progress">
                        0 / 1
                    </span>

                </div>

                <div class="quest-item">

                    <span>
                        Defeat the Monster
                    </span>

                    <span class="quest-progress">
                        0 / 1
                    </span>

                </div>

            </div>

        </section>

    </main>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer>
        <p>
            Flexbox Quest © 2026
        </p>

        <p>
            Built using HTML, CSS and Flexbox.
        </p>
    </footer>

</body>

</html>

